<Window x:Class="ClassroomBooking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бронирование аудиторий" Height="500" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Бронирование компьютерных аудиторий"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Пользователь"/>
            <ComboBox x:Name="UserComboBox" DisplayMemberPath="Name"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Аудитория"/>
            <ComboBox x:Name="RoomComboBox" DisplayMemberPath="Number"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Дата:" VerticalAlignment="Center"/>
                <DatePicker x:Name="BookingDatePicker" Margin="10,0,20,0"/>
                <TextBlock Text="Начало:" VerticalAlignment="Center"/>
                <TextBox x:Name="StartTimeTextBox" Width="70" Margin="10,0,20,0" Text="10:00"/>
                <TextBlock Text="Конец:" VerticalAlignment="Center"/>
                <TextBox x:Name="EndTimeTextBox" Width="70" Margin="10,0,20,0" Text="12:00"/>
                <Button Content="Забронировать"
                       Click="BookButton_Click"
                       Margin="20,0,0,0"
                       Padding="12,5"/>
            </StackPanel>

            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,20,0,10"
                       FontWeight="Bold"/>

            <ListBox x:Name="BookingsListBox"/>
        </StackPanel>
    </Grid>
</Window>
